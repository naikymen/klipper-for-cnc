# F1 test: config-declared ABC axes (XYZABC).
#
# Verifies that [manual_stepper] sections with gcode_axis: auto-register
# as extra axes at connect time and participate in mixed and extra-only
# G1 moves exactly like runtime-registered axes (see extra_axis.test).
DICTIONARY atmega2560.dict
CONFIG extra_axis_declarative.cfg

# Home XYZ before exercising spatial moves.
G28

# Mixed XYZ + single declared extra axis.
G1 X20 Y20 Z10 A10 F3000

# Extra-axis-only move.
G1 A25

# Mixed XYZ + all three declared extra axes.
G1 X25 Y25 A30 B5 C10

# Position queries report the declared axes.
GET_POSITION
M114

# A declared axis can still be unregistered at runtime and re-registered.
MANUAL_STEPPER STEPPER=a_stepper GCODE_AXIS=
G1 X15 Y15 Z5
MANUAL_STEPPER STEPPER=a_stepper GCODE_AXIS=A
G1 X20 Y20 A20

# Motor off.
M84
